# Sehat Saathi Environment Configuration
# Copy this file to .env and configure the keys. Never commit .env to source control!

# Google Gemini API Key (Multimodal OCR & extraction + constrained explanation)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# App configuration
# Use development locally; Vercel deployments should use demo or password-protected test.
SEHAT_ENV=development
SEHAT_TEST_ACCESS_PASSWORD=
DEFAULT_LANGUAGE=hi
ENABLE_VOICE=false
