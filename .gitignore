# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.vercel/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
secrets.toml
.streamlit/secrets.toml

# IDE and OS
.DS_Store
.vscode/
.idea/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# App temporary files & user uploads (privacy by design: do not retain patient images or logs)
data/uploads/*
